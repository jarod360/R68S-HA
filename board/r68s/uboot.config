# Start from the official ODROID-M1 U-Boot RK3568 defconfig.
# ODROID-M1 boots from SPI; R68S boots from eMMC. Avoid SPI-formatted loader.
# CONFIG_ROCKCHIP_SPI_IMAGE is not set
# CONFIG_SPL_SPI_FLASH_SUPPORT is not set
# CONFIG_SPL_SPI is not set
# CONFIG_SPL_SPI_LOAD is not set

# Reuse the upstream generic RK3568 board initialization instead of
# Hardkernel's board selection. Hardware configuration comes from R68S DTS.
# CONFIG_TARGET_ODROID_M1_RK3568 is not set
CONFIG_TARGET_EVB_RK3568=y
CONFIG_DEFAULT_DEVICE_TREE="rockchip/rk3568-fastrhino-r68s"
# U-Boot Binman FIT uses OF_LIST, not just DEFAULT_DEVICE_TREE.
# The official ODROID-M1 list otherwise remains rk3568-odroid-m1.
CONFIG_OF_LIST="rockchip/rk3568-fastrhino-r68s"
CONFIG_SPL_OF_LIST="rockchip/rk3568-fastrhino-r68s"
CONFIG_DEFAULT_FDT_FILE="rockchip/rk3568-fastrhino-r68s.dtb"

# R68S onboard non-removable eMMC.
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_SDMA=y
CONFIG_MMC_SDHCI_ROCKCHIP=y
CONFIG_CMD_MMC=y
# Commands required by the R68S U-Boot boot script.
CONFIG_CMD_PART=y
CONFIG_CMD_FS_GENERIC=y
CONFIG_CMD_FAT=y
CONFIG_CMD_SQUASHFS=y
CONFIG_CMD_FDT=y
CONFIG_CMD_BOOTI=y

# Allow manual eMMC recovery from the U-Boot serial prompt.
CONFIG_USB_GADGET=y
# The base defconfig enables the USB Fastboot function when gadget support is enabled.
# RockUSB does not require Fastboot or a Fastboot buffer address.
# CONFIG_USB_FUNCTION_FASTBOOT is not set
CONFIG_USB_GADGET_DOWNLOAD=y
CONFIG_USB_FUNCTION_ROCKUSB=y
CONFIG_CMD_ROCKUSB=y

# SPL must load the FIT payload from raw eMMC sector 0x4000 (8 MiB).
CONFIG_SPL_MMC=y
CONFIG_SYS_MMCSD_RAW_MODE_U_BOOT_USE_SECTOR=y
CONFIG_SYS_MMCSD_RAW_MODE_U_BOOT_SECTOR=0x4000

# Experimental recovery window: allow UART access to the U-Boot prompt.
# Official HAOS uses CONFIG_BOOTDELAY=-2, preventing interruption.
CONFIG_BOOTDELAY=3
