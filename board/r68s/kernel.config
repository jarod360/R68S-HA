# Keep the official HAOS RK3568 kernel config. Only R68S-specific differences:
# R68S gigabit GMAC (the upstream HAOS base already provides STMMAC).
CONFIG_DWMAC_ROCKCHIP=y
# The root filesystem boots from eMMC, so this must not be a module.
CONFIG_MMC_SDHCI_OF_DWCMSHC=y
# Two PCIe RTL8125B 2.5GbE ports use mainline r8169; no out-of-tree r8125.
CONFIG_R8169=m
CONFIG_R8169_LEDS=y

# HAOS systemd RuntimeWatchdogSec=300; R68S must expose RK3568 /dev/watchdog.
CONFIG_WATCHDOG=y
CONFIG_DW_WATCHDOG=y
